# Backend Environment Variables
# Копіюйте цей файл у .env і заповніть значеннями

# Список дозволених origins для CORS (через кому)
# Додайте тут домен фронтенду (локально і прод):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://wine-server-b5gr.onrender.com

# Порт сервера
PORT=4000

# Хост для прод-середовищ (Render)
HOST=0.0.0.0

# Firebase Admin / Firestore. Зберігайте service account поза репозиторієм.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk.json
FIRESTORE_DATABASE_ID=(default)
# На хостингу можна передати JSON як захищену змінну замість шляху:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Старі MongoDB змінні потрібні лише для одноразової міграції:
# MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
# MONGODB_USER=your_user
# MONGODB_PASSWORD=your_password
# MONGODB_URL=cluster0.xxxxx.mongodb.net
# MONGODB_DB=your_database

# JWT секретний ключ
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT expires in (наприклад: 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# Firebase Authentication (client configuration; API key is public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Cloudinary image uploads
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Node.js середовище
NODE_ENV=production
